# ADC Backup System — Environment Configuration
# Copy this to .env and fill in values before starting.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=0.0.0.0   # overridden at startup to Tailscale IP
FLASK_PORT=8080
FLASK_DEBUG=false

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=/opt/adc-backup/db/state.db
RCLONE_CONF=/opt/adc-backup/rclone.conf
RCLONE_BIN=/usr/bin/rclone
LOG_DIR=/opt/adc-backup/logs
SECRETS_CLASS_YAML=/opt/adc-backup/config/secrets_class.yaml

# ── Auth ──────────────────────────────────────────────────────────────────────
# These are set on first run via the setup wizard — do not set manually.
ADMIN_PASSWORD_HASH=
TOTP_SECRET=

# ── Google OAuth Web Application Credentials ──────────────────────────────────
# Required for 1-click browser authorization at https://asiandvdclub.org/backup/drives/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── MySQL dump ────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=backup_user
MYSQL_PASSWORD=
MYSQL_DUMP_DIR=/opt/adc-backup/dumps

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_SMTP_USER=
NOTIFY_EMAIL_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ── Tailscale ─────────────────────────────────────────────────────────────────
# Set to 1 in production. The app will refuse to start if Tailscale IP is not found.
TAILSCALE_ONLY=1
TAILSCALE_INTERFACE=tailscale0

# ── Hostname (used as subdirectory prefix in Drive paths) ─────────────────────
HOST_NAME=supermicro.local

