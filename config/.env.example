# CloudBackup for Windows — Environment Configuration
# Copy this to .env and adjust paths/port if needed.

# ── Web Server ────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
SERVER_DEBUG=false

# ── Windows System Paths ──────────────────────────────────────────────────────
DB_PATH=C:\ProgramData\CloudBackup\state.db
RCLONE_CONF=C:\ProgramData\CloudBackup\rclone.conf
RCLONE_BIN=C:\ProgramFiles\rclone\rclone.exe
LOG_DIR=C:\ProgramData\CloudBackup\logs
SECRETS_CLASS_YAML=C:\ProgramData\CloudBackup\secrets_class.yaml

# ── Host Identification ───────────────────────────────────────────────────────
HOST_NAME=supermicro.local

# ── Auth & Security ───────────────────────────────────────────────────────────
ADMIN_PASSWORD_HASH=
TOTP_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_SMTP_USER=
NOTIFY_EMAIL_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
