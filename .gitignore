# ─────────────────────────────────────────────────────────────────────────────
# CloudBackup for Windows — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ────────────────────────────
# Secret and Private Config
# ────────────────────────────
config.yaml              # Personal configuration — NEVER commit
*.key                    # Encryption keys
*.pem                    # TLS/SSL certificates
*.env                    # Environment variable files
.env*

# ────────────────────────────
# rclone Secrets
# ────────────────────────────
rclone.conf              # Contains OAuth tokens and remote configs
.rclone.conf

# ────────────────────────────
# Database and State Files
# ────────────────────────────
*.db                     # SQLite databases
*.db-journal
state.json               # Runtime state file
state.json.bak

# ────────────────────────────
# Log Files
# ────────────────────────────
*.log
logs/

# ────────────────────────────
# Backup Catalog & Test Output Directories
# ────────────────────────────
catalog_backups/
restore_test/
test-output/

# ────────────────────────────
# Python & Packaging
# ────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.pyz
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.msi
*.zip

# ────────────────────────────
# Python Test Artifacts
# ────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ────────────────────────────
# IDEs and Editors
# ────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ────────────────────────────
# macOS
# ────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ────────────────────────────
# Windows
# ────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ────────────────────────────
# Temporary Files
# ────────────────────────────
*.tmp
*.bak
*.temp
tmp/
temp/
