# ADC Backup — Secrets Class Declaration
# Add paths here intentionally. Each path is encrypted before upload.
# Do NOT list paths via glob or wildcard — declare exact paths only.
# Recovery passphrase: stored in password manager ONLY, never here.
paths:
  - /etc/ssl
  - /root/.ssh
  - /opt/adc/secrets
  - /opt/adc-backup/rclone.conf
  - /etc/letsencrypt
  - /etc/wireguard
