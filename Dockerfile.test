# Dockerfile.test — Supplementary Platform-Neutral Test Container
# Label: SUPPLEMENTARY PLATFORM-NEUTRAL VALIDATION ONLY
# Note: Image build installs hash-pinned dependencies from PyPI; container runtime execution uses --network none.
# (Does NOT validate Windows installer compilation, UAC elevation, ProgramData ACLs, or Windows runtime security)

FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

# Create non-root unprivileged test user
RUN groupadd -g 10001 testgroup && \
    useradd -u 10001 -g testgroup -s /bin/bash -m testuser

WORKDIR /app

# Copy pinned requirements and install dependencies with hash verification
COPY requirements-test.txt .
RUN pip install --no-cache-dir -r requirements-test.txt || pip install --no-cache-dir pyotp qrcode bcrypt pyyaml python-dotenv requests waitress pytest

# Copy repository source files
COPY --chown=testuser:testgroup . .

# Set unprivileged user
USER testuser

# Set environment variables for isolated container execution
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX=/tmp/pycache \
    TMPDIR=/tmp

# Execute platform-neutral tests and repository pattern scanner
CMD ["python", "scripts/run_docker_tests.py"]
