[Unit]
Description=ADC Backup Web UI (Linux Interface)
After=network.target tailscaled.service
Requires=network.target

[Service]
Type=simple
User=adc-backup
Group=adc-backup
WorkingDirectory=/opt/adc-backup
EnvironmentFile=/opt/adc-backup/config/.env
ExecStart=/opt/adc-backup/venv/bin/python -m linux.app
Restart=always
RestartSec=5
StandardOutput=append:/opt/adc-backup/logs/app.log
StandardError=append:/opt/adc-backup/logs/app.log

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/adc-backup

[Install]
WantedBy=multi-user.target
