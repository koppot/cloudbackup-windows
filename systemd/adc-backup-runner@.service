[Unit]
Description=ADC Backup One-shot Runner for job %i
After=network.target

[Service]
Type=oneshot
User=adc-backup
Group=adc-backup
WorkingDirectory=/opt/adc-backup
EnvironmentFile=/opt/adc-backup/config/.env
ExecStart=/opt/adc-backup/venv/bin/python -c "from linux.engine import run_job; run_job(%i, triggered_by='systemd')"
StandardOutput=append:/opt/adc-backup/logs/runner.log
StandardError=append:/opt/adc-backup/logs/runner.log
